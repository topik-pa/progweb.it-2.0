if posts
  each post, i in posts
    article(class="preview")
      div(class="badge " + post.topic) #[a(href="/" + post.topic, title="Vai alla sezione: " + post.topic.toUpperCase()) #{post.topic}]
      h2
        a(href="/" + post.topic + "/" + post.slug, title=post.desc) #{post.title}
      a(href="/" + post.topic + "/" + post.slug, title=post.desc)
        img(fetchpriority=(i === 0 ? 'high' : undefined), loading=(i >= 1 ? 'lazy' : undefined), width="1200", height="630", src="/assets/images/posts/" + post.topic + "/" + post.slug + ".webp", alt=post.desc, srcset='/assets/images/posts/' + post.topic + '/' + post.slug + '.webp' + ' 1200w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-m.webp' + ' 1024w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-s.webp' + ' 768w', sizes="(max-width: 768px) 100vw, (max-width: 1024px) 75vw, 50vw")
      div !{post.body} #[a(href="/" + post.topic + "/" + post.slug, title=post.desc) Leggi l'articolo completo &xrarr;]

      div(class="published") Pubblicato il #[time(datetime=post.date) #{new Intl.DateTimeFormat('it-IT', {day: 'numeric', month: 'long', year: 'numeric'}).format(new Date(post.date))}]