div
  h1 #{post.title}
  div(class="intro-wrap")
    img(fetchpriority="high" class="cover" width="1200" height="630" src="/assets/images/posts/" + post.topic + "/" + post.slug + ".webp", alt=post.title, srcset='/assets/images/posts/' + post.topic + '/' + post.slug + '.webp' + ' 1200w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-m.webp' + ' 1024w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-s.webp' + ' 768w', sizes="(max-width: 768px) 100vw, (max-width: 1024px) 75vw, 50vw")

    p(class="intro " + post.author) !{post.description} #[img(src="/assets/images/" + post.author +"-talk.webp", alt=post.author + " dice...", width="100", height="100")]


div !{post.body}
