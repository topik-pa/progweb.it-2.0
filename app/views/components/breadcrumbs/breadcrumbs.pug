if breadcrumbs
  div(id="breadcrumbs")
    nav
      a(href='/', title="Home")= __('views.home')
      span &nbsp;
      each elem in breadcrumbs
        span &nbsp;&#10142;&nbsp;
        if elem.url
          a(href='/'+'/'+elem.url, title=__('views.' + elem.id))= __('views.' + elem.id)
        else
          span= __('views.' + elem.id)
