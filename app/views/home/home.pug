//- Home Page Template
//-
//- This template extends the base layout and defines the home page structure.
//-
//- Blocks:
//-   - meta: Appends Open Graph tags, SEO meta tags, canonical URL, and hreflang links
//-   - main: Contains the main heading for the home page
//-
//- Variables expected:
//-   - og_image: URL to the Open Graph image
//-   - canonical: Canonical URL for the page
//-   - hreflangs: Array of objects containing language alternatives (lang, url)
//-
//- i18n keys used:
//-   - proj_tagline: Project tagline/slogan
//-   - proj_name: Project name
//-   - proj_description: Project description
//-   - index.meta.keywords: SEO keywords for the home page
//-   - home.title: Main heading text for the home page

extends ../layout.pug

block append meta
  meta(property="og:title" content=__('proj_tagline') + ' | ' + __('proj_name') )
  meta(property="og:description" content=__('proj_description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonical)

  title= __('proj_tagline') + ' | ' + __('proj_name')
  meta(name="description" content=__('proj_description'))
  meta(name="keywords" content=__('home.meta.keywords'))

  link(rel="canonical", href=canonical)

block main
  section
    hgroup
      h1 Benvenuto su #{proj_name} #[br]
        small #{proj_description}

    p Qui troverai #[em pillole quotidiane] di sviluppo Web e non solo... Con "pillole" si intendono articoli, guide avvisi #[em sulle novità del mondo della Programmazione Web], sulle tecniche per imbastire una Architettura informativa, sulla Sicurezza e tutto ciò che concerne questi aspetti.
    p Gli argomenti principali sono: i #[em Cascading Style Sheets] (CSS), l'#[em Hyper Text Markup Language] (HTML), il linguaggio di #[em scripting JavaScript], il #[em framework NodeJS] (basato su JavaScript), l'#[em Architettura] e la #[em Sicurezza] in ambito Web.
    p Se ti fa piacere rimanere aggiornato sulle pubblicazioni quotidiane di nuovi post, ti suggeriamo di iscriverti sui nostri canali social: 
      each social in socials
        span 
          a(href=social.url, title=social.name) #[i(class=social.icon)] #{social.name}&nbsp;&nbsp;
    p Questi che seguono sono gli ultimi articoli pubblicati...#[br]#[br]

    include ../components/post_preview/post_preview.pug

  include ../components/side/side.pug
