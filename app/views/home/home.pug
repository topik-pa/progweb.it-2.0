//- Home Page Template
//-
//- This template extends the base layout and defines the home page structure.
//-
//- Blocks:
//-   - meta: Appends Open Graph tags, SEO meta tags, canonical URL, and hreflang links
//-   - main: Contains the main heading for the home page
//-
//- Variables expected:
//-   - og_image: URL to the Open Graph image
//-   - canonical: Canonical URL for the page
//-   - hreflangs: Array of objects containing language alternatives (lang, url)
//-
//- i18n keys used:
//-   - proj_tagline: Project tagline/slogan
//-   - proj_name: Project name
//-   - proj_description: Project description
//-   - index.meta.keywords: SEO keywords for the home page
//-   - home.title: Main heading text for the home page

extends ../layout.pug

block append meta
  meta(property="og:title" content=__('proj_tagline') + ' | ' + __('proj_name') )
  meta(property="og:description" content=__('proj_description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonical)

  title= __('proj_tagline') + ' | ' + __('proj_name')
  meta(name="description" content=__('proj_description'))
  meta(name="keywords" content=__('home.meta.keywords'))

  link(rel="canonical", href=canonical)

block main
  section
    hgroup
      h1 Benvenuto su #{proj_name} #[br]
        small #{proj_description}

    if posts
      each post in posts
        div(class="preview")
          div(class="badge " + post.topic) #[a(href="/" + post.topic, title=post.topic) #{post.topic}]
          h2
            a(href="/" + post.topic + "/" + post.slug, title=post.short_desc) #{post.title}
          a(href="/" + post.topic + "/" + post.slug, title=post.short_desc)
            img(fetchpriority="high", class="cover", width="1200", height="630", src="/assets/images/posts/" + post.topic + "/" + post.slug + ".webp", alt=post.short_desc, srcset='/assets/images/posts/' + post.topic + '' + post.slug + '.webp' + ' 1200w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-m.webp' + ' 1024w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-s.webp' + ' 768w', sizes="(max-width: 768px) 100vw, (max-width: 1024px) 75vw, 50vw")
          div !{post.short_body} #[a(href="/" + post.topic, title=post.topic) &lbrack;Leggi l'articolo completo&rbrack;]

          div(class="published") Pubblicato il <time datetime=post.date>#{new Intl.DateTimeFormat('it-IT', {day: 'numeric', month: 'long', year: 'numeric'}).format(new Date(post.date))}</time>


  include ../components/side.pug
