aside(id="side")

  div(class="submenu topic")
    h3 Argomenti
    ul
      li(class="html") #[a(href="/html", title="HTML") HTML]
      li(class="css") #[a(href="/css", title="CSS") CSS]
      li(class="js") #[a(href="/javascript", title="JavaScript") JavaScript]
      li(class="eng") #[a(href="/engineering", title="Software Engineering") Software Engineering]
      li(class="sec") #[a(href="/security", title="Cybersecurity") Cybersecurity]
      li(class="node") #[a(href="/nodejs", title="Node.js") Node.js]

  div(class="submenu socials")
    h3 Social
    p I nostri Canali Social
    ul
      each social in socials
        li
          a(href=social.url, title=social.name) #[i(class=social.icon)] #{social.name}

    p #[em Contatta PWI] per commentare o suggerire come migliorare i contenuti
    ul
      li
        a(href="mailto:info@progweb.it", title="Mail") #[i(class="icon-envelop")] info@progweb.it

  div(class="submenu others")
    h3 Gli ultimi articoli
