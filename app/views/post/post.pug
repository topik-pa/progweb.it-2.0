extends ../layout.pug

block append meta
  title #{post.title}
  meta(name="description" content=post.description)
  meta(name="keywords" content=post.keywords)
  link(rel="canonical", href=canonical)

  meta(name="og:url" content=canonical)
  meta(name="og:type" content="article")
  meta(name="og:title" content=post.title)
  meta(name="og:site_name" content=proj_name)
  meta(name="og:description" content=post.description)
  meta(name="og:image" content=proj_url + "/assets/images/posts/" + post.topic + "/" + post.slug + ".webp")

block main
  article
    include ./article.pug
    include ../components/share/share.pug
  include ../components/side/side.pug

block viewscripts
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "datePublished": "#{post.date}",
      "dateModified": "#{post.modified}",
      "url": "#{canonical}",
      "name": "#{post.title}",
      "headline": "#{post.title}",
      "description": "#{post.description}",
      "image": "#{proj_url + "/assets/images/posts/" + post.topic + "/" + post.slug + ".webp"}",
      "author": {
        "@type": "Person",
        "name": "#{proj_owner}"
      },
      "copyrightHolder": {
        "@type": "Person",
        "name": "#{proj_owner}"
      },
      "publisher": {
        "@type": "Organization",
        "name": "#{proj_name}",
        "url": "#{proj_url}",
        "logo": "#{proj_logo}"
      }
    }
