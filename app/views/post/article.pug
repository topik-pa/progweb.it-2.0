div
  h1 #{post.title}
  div(class="intro-wrap")
    img(fetchpriority="high" class="cover" width="1200" height="630" src="/assets/images/posts/" + post.topic + "/" + post.slug + ".webp", alt='Articolo ' + post.topic + ' - ' + post.title, srcset='/assets/images/posts/' + post.topic + '/' + post.slug + '.webp' + ' 1200w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-m.webp' + ' 1024w,' + '/assets/images/posts/' + post.topic + '/' + post.slug + '-s.webp' + ' 768w', sizes="(max-width: 768px) 100vw, (max-width: 1024px) 75vw, 50vw")

    p(class="intro " + post.author) !{post.description} #[img(src="/assets/images/" + post.author +"-talk.webp", alt=post.author + " dice...", width="80", height="80")]


if post.widget
div.widget 
  a(href="#widget") Prova il Widget Online &#8681;
  p In questo articolo è presente un widget dinamico: utilizzalo per mettere alla prova quello che hai imparato!


div !{post.body}
