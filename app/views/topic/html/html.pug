extends ../../layout.pug

block append meta
  meta(property="og:title" content=__('views.html') + ' | ' + __('proj_name'))
  meta(property="og:description" content=__('html.meta.description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonical)

  title= __('views.html') + ' | ' + proj_name
  meta(name="description" content=__('html.meta.description'))
  meta(name="keywords" content=__('html.meta.keywords'))

  link(rel="canonical", href=canonical)

block main
  include ../../components/breadcrumbs/breadcrumbs.pug

  main(class="tworows")
    section
      h1= __('html.title')

    include ../../components/side.pug

