extends ../layout.pug

block append meta
  meta(property="og:title" content=__('views.contacts') + ' | ' + __('proj_name'))
  meta(property="og:description" content=__('contacts.meta.description'))
  meta(property="og:image" content=og_image)
  meta(property="og:url" content=canonical)

  title= __('views.contacts') + ' | ' + proj_name
  meta(name="description" content=__('contacts.meta.description'))
  meta(name="keywords" content=__('contacts.meta.keywords'))

  link(rel="canonical", href=canonical)

block main
  section
    h1= __('contacts.title')
    p Contatta PWI per domande, informazioni o altre necessità attraverso i seguenti canali.
    section 
      h2 Tramite email
      p E' possibile utilizzare questi indirizzo email: 
        br
        br
        a(href="mailto:info@progweb.it") info@progweb.it
        br
        a(href="mailto:marco@progweb.it") marco@progweb.it
    section
      h2 Tramite Social
      p E' possibile mandare un messaggio tramite i seguenti Social
      ul 
        each social in socials
          li
            a(href=social.url, title=social.name) #[i(class=social.icon)] #{social.name}
