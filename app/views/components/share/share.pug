aside(id="share")
  h2 #[em Condividi] questo contenuto tra i tuoi contatti!
  p Se pensi ti sia stato utile, aiuta la comunità di sviluppatori condividendo questo contenuto.
  section
    div
      a(href=socials[0].url, title="Condividi su Facebook") Su Facebook #[br]#[br]
        i(class=socials[0].icon)
    div
      a(href=socials[1].url, title="Condividi su LinkedIn") Su LinkedIn #[br]#[br]
        i(class=socials[1].icon)
    div
      a(href=socials[2].url, title="Condividi su Telegram") Su Telegram #[br]#[br]
        i(class=socials[2].icon)
