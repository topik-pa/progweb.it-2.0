aside(id="side")

  div(class="submenu topic")
    h3 Argomenti
    ul
      li(class="html") #[a(href="/html", title="HTML") HTML]
      li(class="css") #[a(href="/css", title="CSS") CSS]
      li(class="javascript") #[a(href="/javascript", title="JavaScript") JavaScript]
      li(class="engineering") #[a(href="/engineering", title="Software Engineering") Software Engineering]
      li(class="nodejs") #[a(href="/nodejs", title="Node.js") Node.js]
      li(class="security") #[a(href="/security", title="Cyber Security") Cyber Security]

  div(class="submenu socials")
    h3 Social
    p I Canali Social
    ul
      each social in socials
        li
          a(href=social.url, title=social.name) #[i(class=social.icon)] #{social.name}

    p #[em Contatta PWI] per commentare o suggerire come migliorare i contenuti
    ul
      li
        a(href="mailto:info@progweb.it", title="Mail per questioni generiche") #[i(class="icon-envelop")] info@progweb.it
      li  
        a(href="mailto:marco@progweb.it", title="Mail diretta per questioni più specifiche") #[i(class="icon-envelop")] marco@progweb.it

  div(class="submenu last")
    if lastPosts
      h3 Gli ultimi articoli
      ul
        each post in lastPosts
          li
            a(href="/" + post.topic + "/" + post.slug, title=post.title) #{post.desc}
              img(loading="lazy", width="768", height="403", src="/assets/images/posts/" + post.topic + "/" + post.slug + "-m.webp", alt=post.desc)

