extends ../layout.pug

block append meta
  title #{post.title}
  meta(name="description" content=post.description)
  meta(name="keywords" content=post.keywords)
  link(rel="canonical", href=canonical)

  meta(property="og:url" content=canonical)
  meta(property="og:type" content="article")
  meta(property="og:title" content=post.title)
  meta(property="og:description" content=post.description)
  meta(property="og:image" content=proj_url + "/assets/images/posts/" + post.topic + "/" + post.slug + ".webp")

block main
  article
    include ./article.pug
    if post.related
      include ./related.pug
    include ../components/share/share.pug
  include ../components/side/side.pug

block viewscripts
  if post.widget
    script(type='module', nonce=nonce)!= widget
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": ["Article", "TechArticle"],
      "datePublished": "#{post.date}",
      "dateModified": "#{post.modified}",
      "url": "#{canonical}",
      "name": "#{post.title}",
      "headline": "#{post.title}",
      "description": "#{post.description}",
      "image": "#{proj_url + "/assets/images/posts/" + post.topic + "/" + post.slug + ".webp"}",
      "author": {
        "@type": "Person",
        "name": "#{proj_owner}"
      },
      "copyrightHolder": {
        "@type": "Person",
        "name": "#{proj_owner}"
      },
      "publisher": {
        "@type": "Organization",
        "name": "#{proj_name}",
        "url": "#{proj_url}",
        "logo": "#{proj_logo}"
      }
    }
  script(type='application/ld+json').
    {
      "@context": "https://schema.org", 
      "@type": "BlogPosting",
      "headline": "#{post.title}",
      "image": "#{proj_url + "/assets/images/posts/" + post.topic + "/" + post.slug + ".webp"}",
      "editor": "#{proj_owner}", 
      "genre": "programmazione web #{post.topic} #{post.slug}", 
      "keywords": "#{post.keywords}", 
      "publisher": "#{proj_name}",
      "url": "#{canonical}",
      "datePublished": "#{post.date}",
      "dateCreated": "#{post.date}",
      "dateModified": "#{post.modified}",
      "description": "#{post.description}",
      "articleBody": "#{post.slug} - #{post.title} - #{post.description}",
        "author": {
          "@type": "Person",
          "name": "#{proj_owner}"
        }
    }
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": "#{proj_url}/#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "#{proj_url}"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "#{post.topic}",
          "item": "#{proj_url}/#{post.topic}"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "#{post.title}"
        }
      ]
    }
  if post.widget
    script(type='application/ld+json').
      {
        "@context": "https://schema.org",
        "@type": ["WebApplication", "LearningResource"],
        "@id": "#{canonical}#flexbox-playground",
        "name": "#{post.widget}",
        "description": "#{post.widget} - Strumento didattico interattivo",
        "url": "#{canonical}#flexbox-playground",
        "inLanguage": "it-IT",
        "applicationCategory": "EducationalApplication",
        "applicationSubCategory": "Strumento didattico #{post.topic}",
        "operatingSystem": "Any",
        "browserRequirements": "JavaScript",
        "isAccessibleForFree": true,
        "learningResourceType": "Dimostrazione interattiva",
        "educationalUse": "Sperimentazione",
        "educationalLevel": [
          "Intermedio",
          "Avanzato"
        ],
        "interactivityType": "active",
        "competencyRequired": "Programmazione Web, HTML5, CSS3, JavaScript",
        "offers": {
          "@type": "Offer",
          "price": 0,
          "priceCurrency": "EUR"
        }
      }
